import logging
import subprocess
import os

def usage():
    logging.info("Ostrich Cache Manager")
    logging.info("Usage: ost run cache <subcommand> [options]")
    logging.info("")
    logging.info("Available subcommands:")
    logging.info("  list        List docker volumes associated with the current project and show sizes")
    logging.info("              Options:")
    logging.info("                -a    List all buildpack-related cache volumes")
    logging.info("  clean       Remove docker volumes associated with the current project")
    logging.info("              Options:")
    logging.info("                -a    Clean ALL buildpack-related cache volumes (impacts all projects)")
    logging.info("                -y    Do not ask for confirmation")
    logging.info("  help        Print this help message")

def get_filter_str(show_all=False):
    if show_all:
        return "pack-cache"
    
    # Get image name using Jinja expression
    image_name = "[[ template.params.image_name or plugin.name ]]"
    
    # Handle missing tag -> default to :latest
    if ":" not in image_name:
        image_name = f"{image_name}:latest"
    
    # Strip registry part if present (has . or : in first segment)
    parts = image_name.split('/')
    if len(parts) > 1 and ('.' in parts[0] or ':' in parts[0]):
        display_name = "/".join(parts[1:])
    else:
        display_name = image_name
        
    # Add 'library/' prefix if it's a single word repository name, as pack/docker do
    if "/" not in display_name:
        display_name = f"library/{display_name}"

    # Form the strict pattern starting with pack-cache-
    return "pack-cache-" + display_name.replace("/", "_").replace(":", "_")

def parse_size(size_str):
    units = {"B": 1, "KB": 10**3, "MB": 10**6, "GB": 10**9, "TB": 10**12}
    size_str = size_str.upper().strip()
    if size_str == "0B": return 0
    
    number = ""
    unit = ""
    for i, char in enumerate(size_str):
        if char.isdigit() or char == '.':
            number += char
        else:
            unit = size_str[i:]
            break
    
    multiplier = 1
    for k, v in units.items():
        if k == unit:
            multiplier = v
            break
            
    try:
        return float(number) * multiplier
    except ValueError:
        return 0

def format_size(size_bytes):
    if size_bytes == 0: return "0B"
    units = ["B", "KB", "MB", "GB", "TB"]
    i = 0
    while size_bytes >= 1000 and i < len(units) - 1:
        size_bytes /= 1000
        i += 1
    return f"{size_bytes:.1f}{units[i]}"

def get_volume_sizes():
    sizes = {}
    try:
        res = subprocess.run(["docker", "system", "df", "-v"], capture_output=True, text=True, check=True)
        output = res.stdout
        if "Local Volumes space usage:" in output:
            section = output.split("Local Volumes space usage:")[1].strip()
            for line in section.splitlines()[1:]:
                parts = line.split()
                if len(parts) >= 3:
                    name = parts[0]
                    size = parts[-1]
                    sizes[name] = size
    except Exception as e:
        logging.error(f"Failed to retrieve volume sizes: {e}")
    return sizes

def list_volumes(show_all=False):
    filter_str = get_filter_str(show_all)
    
    if show_all:
        logging.info("Listing all buildpack cache volumes:")
    else:
        image_name = "[[ template.params.image_name or plugin.name ]]"
        logging.info(f"Image name: {image_name}")
        logging.info(f"Filtering volumes with pattern: {filter_str}")
    
    sizes = get_volume_sizes()
    if sizes:
        print(f"{'VOLUME NAME':<65} {'SIZE':<10}")
        print("-" * 76)
        found = False
        for name, size in sizes.items():
            if filter_str in name:
                print(f"{name:<65} {size:<10}")
                found = True
        if not found:
            logging.info("No matching volumes found.")
    else:
        subprocess.run(["docker", "volume", "ls", "--filter", f"name={filter_str}"], check=True)

def clean_volumes(force=False, show_all=False):
    filter_str = get_filter_str(show_all)
    
    try:
        res = subprocess.run(["docker", "volume", "ls", "-q", "--filter", f"name={filter_str}"], capture_output=True, text=True, check=True)
        volumes = res.stdout.splitlines()
        
        if not volumes:
            logging.info(f"No volumes found matching pattern: {filter_str}")
            return

        sizes = get_volume_sizes()
        total_reclaimed_bytes = 0
        
        logging.info(f"The following volumes will be removed:")
        for v in volumes:
            size_str = sizes.get(v, "unknown")
            print(f" - {v:<62} [{size_str}]")
            total_reclaimed_bytes += parse_size(size_str)
            
        if not force:
            if show_all:
                print("\n!!! WARNING: You are cleaning ALL buildpack cache volumes.")
                print("!!! This will impact ALL projects, not only your current one.")
                answer = input("\nAre you absolutely sure you want to proceed? (y/N): ")
            else:
                answer = input("\nAre you sure you want to proceed? (y/N): ")
                
            if answer.lower() != 'y':
                logging.info("Cleanup cancelled.")
                return

        for v in volumes:
            logging.info(f"Removing volume: {v}")
            subprocess.run(["docker", "volume", "rm", v], check=True)
            
        logging.info("Cleanup completed successfully.")
        logging.info(f"Total space saved: {format_size(total_reclaimed_bytes)}")

    except Exception as e:
        logging.error(f"Failed to clean volumes: {e}")

if _argc > 0:
    subcommand = _argv[0]
    if subcommand == "list":
        show_all = "-a" in _argv[1:]
        list_volumes(show_all)
    elif subcommand == "clean":
        force = "-y" in _argv[1:]
        show_all = "-a" in _argv[1:]
        clean_volumes(force, show_all)
    elif subcommand == "help":
        usage()
    else:
        logging.warning(f"Unknown subcommand: {subcommand}")
        usage()
else:
    usage()
