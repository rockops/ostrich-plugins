import logging

# The image name and registry are provided via the template parameters
registry = "[[ template.params.registry or "" ]]"
image_name = "[[ template.params.image_name or plugin.name ]]"

if not image_name:
    raise OstrichException("The 'image_name' parameter or 'plugin.name' is required to identify containers to stop.")

full_image_name = f"{registry.rstrip('/')}/{image_name}" if registry else image_name

logging.info(f"Stopping containers running image: {full_image_name}")

# Standard docker ps command to find container IDs by image
# ancestor filter matches containers created from this image
find_cmd = ["docker", "ps", "-q", "--filter", f"ancestor={full_image_name}"]

if _dryRun:
    logging.info(f"Dry run: {' '.join(find_cmd)}")
else:
    try:
        # 'run' is available in global scope (equivalent to subprocess.run)
        result = run(find_cmd, capture_output=True, text=True)
        if result.returncode != 0:
            raise OstrichException(f"Failed to list containers: {result.stderr}")
        
        container_ids = result.stdout.strip().split()
        
        if not container_ids:
            logging.info(f"No active containers found for image '{full_image_name}'.")
        else:
            logging.info(f"Found {len(container_ids)} container(s) to stop: {', '.join(container_ids)}")
            stop_cmd = ["docker", "stop"] + container_ids
            
            if _dryRun:
                logging.info(f"Dry run: {' '.join(stop_cmd)}")
            else:
                stop_result = run(stop_cmd)
                if stop_result.returncode != 0:
                    raise OstrichException(f"Failed to stop containers. Exit code: {stop_result.returncode}")
                
                logging.info("Stop operation completed successfully.")
            
    except Exception as e:
        if isinstance(e, OstrichException):
            raise
        raise OstrichException(f"An error occurred while stopping containers: {str(e)}")
