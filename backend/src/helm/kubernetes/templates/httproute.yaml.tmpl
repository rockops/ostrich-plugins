{{- if .Values.exposure.hostname }}
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: {{ .Release.Name }}
spec:
  parentRefs:
    - name: {{ if .Values.exposure.gateway.create }}{{ .Release.Name }}-gateway{{ else }}{{ .Values.exposure.gateway.name }}{{ end }}
      namespace: {{ .Values.exposure.gateway.namespace | quote }}
  hostnames:
    - {{ .Values.exposure.hostname | quote }}
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /
      backendRefs:
        - name: {{ .Release.Name }}
          port: {{ .Values.service.port }}
{{- end }}
